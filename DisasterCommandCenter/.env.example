# Ejemplo: sustituye usuario, contrasena y base por los de tu servidor.
# Los scripts leen variables del proceso; no cargan .env automaticamente.
DCC_DATABASE_URL=postgresql://dcc_user:CHANGE_ME@127.0.0.1:5432/disaster_command_center

# Pruebas: un directorio de binarios permite crear un cluster temporal.
# DCC_POSTGRES_BIN=C:\Program Files\PostgreSQL\18\bin
# Alternativa: una base de pruebas donde puedas crear esquemas exclusivos.
# DCC_TEST_DATABASE_URL=postgresql://dcc_test:CHANGE_ME@127.0.0.1:5432/dcc_test
